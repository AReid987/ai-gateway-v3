{
  "name": "AI Gateway Integration",
  "description": "Claude Flow configuration using our AI Gateway instead of LiteLLM",
  "version": "1.0.0",
  "gateway": {
    "base_url": "http://localhost:8080",
    "timeout": 30,
    "retry_attempts": 3
  },
  "models": {
    "claude-3-sonnet": {
      "gateway_model": "anthropic/claude-3-5-sonnet",
      "fallbacks": ["groq/llama-3.1-70b-versatile", "gemini/gemini-2.0-flash"]
    },
    "claude-3-haiku": {
      "gateway_model": "anthropic/claude-3-5-haiku", 
      "fallbacks": ["groq/llama-3.1-8b-instant", "gemini/gemini-1.5-flash"]
    },
    "gpt-4": {
      "gateway_model": "openai/gpt-4o-mini",
      "fallbacks": ["groq/llama-3.1-70b-versatile", "gemini/gemini-2.0-flash"]
    },
    "llama": {
      "gateway_model": "groq/llama-3.1-8b-instant",
      "fallbacks": ["groq/llama-3.1-70b-versatile", "mistral/mistral-small"]
    },
    "gemini": {
      "gateway_model": "gemini/gemini-2.0-flash",
      "fallbacks": ["gemini/gemini-1.5-flash", "groq/llama-3.1-8b-instant"]
    }
  },
  "routing": {
    "default_router": "main",
    "fast_router": "fast",
    "strategies": {
      "balanced": "main",
      "speed": "fast"
    }
  }
}
